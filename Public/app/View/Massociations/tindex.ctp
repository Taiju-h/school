    <script>
        const canvas = document.getElementById('canvas'),
            layer = document.querySelector('.contents-area'),
            buttons = document.getElementsByClassName('link-item'),
            htmlBody = document.body

        let scrollPosi = 0,
            viewWidth = htmlBody.clientWidth,
            flag = false

        const handler = (entries) => {
            viewWidth = entries[0].contentRect.width
            if (764 < viewWidth && flag === true) {
                flag = false
                closeModal()
            }
        };
        const observer = new window.ResizeObserver(handler);
        observer.observe(htmlBody);

        function onClickLink(target, num) {
            if (viewWidth < 765) {
                showModal()
            }
            showContents(target, num)
        }

        function showContents(target, num) {
            canvas.innerHTML = ""
            const content = document.getElementById(`data${num}`)
            const copy = content.cloneNode(true)
            canvas.append(copy)

            for (let i = 0; i < buttons.length; i++) {
                buttons[i].classList.remove('active')
            }

            target.classList.add('active')
        }

        function showModal() {
            flag = true
            bodyLock()
            layer.classList.remove("is-hide");
        }

        function closeModal() {
            flag = false
            htmlBody.classList.remove("fixed");
            window.scroll({ top: scrollPosi, behavior: "instant" });
            layer.classList.add("is-hide");
        }

        function getScrollTop(window) {
            let document;
            let body;
            return (
                'pageYOffset' in window
                    ? window.pageYOffset
                    : ((document = window.document).documentElement || (body = document.body).parentNode || body).scrollTop
            );
        };

        function bodyLock() {
            scrollPosi = getScrollTop(window);
            htmlBody.classList.add("fixed");
            htmlBody.style.top = `-${scrollPosi}px`;
        }
    </script>
